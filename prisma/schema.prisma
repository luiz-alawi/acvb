// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model UniformOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  number    Int
  size      String
  type      String   @default("COMUM") 
  email     String
  status    String   @default("PENDENTE") 
  createdAt DateTime @default(now())
}

model MatchRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamName  String
  location  String
  date      String
  time      String
  email     String
  status    String   @default("PENDENTE") 
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  opponent  String
  location  String
  date      String
  time      String
  createdAt DateTime @default(now())
}

model Player {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  number    Int
  position  String
  createdAt DateTime @default(now())
}